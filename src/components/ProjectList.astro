---
// The list of project links used on the homepage and every category page.
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
  /** Shown in place of the list when there's nothing filed here yet. */
  empty?: string;
}
const { projects, empty = 'Nothing here yet.' } = Astro.props;
---

{
  projects.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ul class="project-list">
      {projects.map(({ id, data }) => (
        <li>
          <div class="row">
            <a class="title" href={`/projects/${id}/`}>
              {data.featured && <span class="star" title="featured">✦ </span>}
              {data.title}
            </a>
            <time class="meta" datetime={data.date.toISOString()}>
              {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
            </time>
          </div>
          <p class="desc">{data.description}</p>
          <p class="tags">
            {data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-list li {
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .title:hover {
    color: var(--accent-bright);
  }

  .star {
    color: var(--accent);
  }

  time {
    white-space: nowrap;
  }

  .desc {
    margin: 0.35rem 0 0.6rem;
    color: var(--ink-muted);
  }

  .tags {
    margin: 0;
  }

  .empty {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-style: italic;
  }
</style>
