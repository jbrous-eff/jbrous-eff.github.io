---
// The list of project links used on the homepage and every category page.
// Two card shapes: the classic text row linking to a detail page, and a
// self-contained portfolio card when the project has a cardImage (chart +
// headline + byline, no link — the card IS the piece).
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
  /** Shown in place of the list when there's nothing filed here yet. */
  empty?: string;
}
const { projects, empty = 'Nothing here yet.' } = Astro.props;
---

{
  projects.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ul class="project-list">
      {projects.map(({ id, data }) => (
        <li>
          {data.cardImage && (
            <span class="chart">
              <img src={data.cardImage} alt={data.title} loading="lazy" />
            </span>
          )}
          <div class="row">
            {data.cardImage ? (
              <span class="title">
                {data.featured && <span class="star" title="featured">✦ </span>}
                {data.title}
              </span>
            ) : (
              <a class="title" href={`/projects/${id}/`}>
                {data.featured && <span class="star" title="featured">✦ </span>}
                {data.title}
              </a>
            )}
            <time class="meta" datetime={data.date.toISOString()}>
              {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
            </time>
          </div>
          <p class="desc">{data.description}</p>
          <p class="tags">
            {data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-list li {
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }

  .chart {
    display: block;
    margin-bottom: 1.1rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .chart img {
    display: block;
    width: 100%;
    height: auto;
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  a.title:hover {
    color: var(--accent-bright);
  }

  .star {
    color: var(--accent);
  }

  time {
    white-space: nowrap;
  }

  .desc {
    margin: 0.35rem 0 0.6rem;
    color: var(--ink-muted);
  }

  .tags {
    margin: 0;
  }

  .empty {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-style: italic;
  }
</style>
