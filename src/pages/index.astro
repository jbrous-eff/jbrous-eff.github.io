---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => {
  // Featured first, then newest first
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<Base title="Project Hub">
  <h1>Projects</h1>
  <ul class="project-list">
    {
      projects.map(({ id, data }) => (
        <li>
          <a href={`/projects/${id}/`}>{data.title}</a>
          {data.featured && <span class="tag">featured</span>}
          <p>{data.description}</p>
          <p>
            <time datetime={data.date.toISOString()}>
              {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            {data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .project-list {
    list-style: none;
    padding: 0;
  }
  .project-list li {
    margin-bottom: 2rem;
  }
  .project-list li > a {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .project-list p {
    margin: 0.25rem 0;
  }
  .project-list time {
    font-size: 0.85rem;
    color: #777;
    margin-right: 0.5rem;
  }
</style>
