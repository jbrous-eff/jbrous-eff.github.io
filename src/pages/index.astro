---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import { getPublishedProjects } from '../projects';

const recent = (await getPublishedProjects()).slice(0, 5);
---

<Base title="jeffbrous — projects and experiments">
  <h1>A portfolio of sports analysis and consulting.</h1>
  <p class="lede">Browse by category in the nav, or start with what's newest below.</p>

  <section>
    <h2 class="section-head">Recent</h2>
    <ProjectList projects={recent} empty="Check back soon." />
  </section>
</Base>

<style>
  h1 {
    font-size: 1.85rem;
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 0.95rem;
    color: var(--ink-faint);
    margin-bottom: 3rem;
  }

  .section-head {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }
</style>
