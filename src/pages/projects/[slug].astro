---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { categoryBySlug } from '../../categories';

export async function getStaticPaths() {
  // cardImage projects are self-contained portfolio cards — no detail page.
  const projects = await getCollection('projects', ({ data }) => !data.draft && !data.cardImage);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, date, category, tags, link, repo, image } = project.data;
const bucket = categoryBySlug(category);
---

<Base title={`${title} — jeffbrous`} description={description} active={category} image={image}>
  <article>
    <p class="meta back"><a href={`/${category}/`}>← {bucket?.label ?? 'All projects'}</a></p>
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </p>
    {
      (link || repo) && (
        <p class="links">
          {link && <a href={link}>View it live ↗</a>}
          {link && repo && <span class="sep"> · </span>}
          {repo && <a href={repo}>Source code ↗</a>}
        </p>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    margin-bottom: 2.5rem;
  }

  .back a {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }

  h1 {
    margin-bottom: 0.5rem;
  }

  .meta :global(.tag) {
    margin-left: 0.5rem;
    margin-right: 0;
  }

  .links {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .sep {
    color: var(--ink-faint);
  }

  .prose {
    margin-top: 2.5rem;
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.5rem;
  }

  .prose :global(h3) {
    margin-top: 2rem;
    font-size: 1.15rem;
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
    color: var(--ink-muted);
    font-style: italic;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }

  .prose :global(pre) {
    background: var(--bg-raised) !important;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2.5rem 0;
  }

  .prose :global(figure) {
    margin: 1.5rem 0;
  }

  .prose :global(figcaption) {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    font-style: italic;
    color: var(--ink-faint);
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.5rem 1rem 0.5rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    font-weight: 500;
  }
</style>
