---
// Shared page shell. Design: bone on graphite, no accent hue anywhere in the
// chrome — links carry an underline instead of a color, and emphasis is done
// with brightness. All saturated color belongs to the charts inside projects.
// Two columns on desktop: category nav on the left, page content on the right.
import { CATEGORIES } from '../categories';
import { getPublishedProjects } from '../projects';

// Categories with nothing filed yet get a "soon" badge in the nav instead of
// silently looking like a dead link.
const projectCounts = new Map<string, number>();
for (const project of await getPublishedProjects()) {
  projectCounts.set(project.data.category, (projectCounts.get(project.data.category) ?? 0) + 1);
}

interface Props {
  title: string;
  description?: string;
  /** Category slug to highlight in the sidebar, if the page belongs to one. */
  active?: string;
  /** Social-preview image path, e.g. a project's chart. Falls back to no image. */
  image?: string;
}
const {
  title,
  description = 'Data analysis, writing, and consulting work by Jeff Brous.',
  active,
  image,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="jeffbrous" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  </head>
  <body>
    <div class="shell">
      <header>
        <a href="/" class="wordmark">jeff brous</a>
        <nav aria-label="Project categories">
          <ul>
            {
              CATEGORIES.map((c) => (
                <li>
                  <a
                    href={`/${c.slug}/`}
                    class={active === c.slug ? 'active' : undefined}
                    aria-current={active === c.slug ? 'page' : undefined}
                  >
                    {c.label}
                    {!projectCounts.get(c.slug) && <span class="soon">soon</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
      <div class="column">
        <main>
          <slot />
        </main>
        <footer>
          <span class="rule" aria-hidden="true"></span>
          <p>
            © {new Date().getFullYear()} jeffbrous.com ·{' '}
            <a href="mailto:jbrous@gmail.com">jbrous@gmail.com</a>
          </p>
        </footer>
      </div>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #111214;
    --bg-raised: #191b1e;
    --ink: #f2efe9;
    --ink-muted: #9b9a96;
    --ink-faint: #6a6a67;
    /* Not a hue — "accent" here means brighter than the text around it. */
    --accent: #f2efe9;
    --accent-bright: #ffffff;
    --line: #26282c;
    /* One family, three roles. Display differs from body by weight and
       tracking, not by typeface — no serif anywhere on the site. */
    --font-display: 'IBM Plex Sans', sans-serif;
    --font-body: 'IBM Plex Sans', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color-scheme: dark;
  }

  body {
    margin: 0 auto;
    max-width: 58rem;
    padding: 2.5rem 1.25rem 4rem;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink);
    position: relative;
  }

  /* Nav column + content column. Collapses to a single stack on narrow screens. */
  .shell {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  .column {
    min-width: 0;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.15;
    /* Sans needs tighter tracking than the serif did to hold together at size */
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  h1 {
    font-size: 2.25rem;
    letter-spacing: -0.035em;
  }

  a {
    color: var(--accent);
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 3px;
    transition: color 120ms ease;
  }

  a:hover {
    color: var(--accent-bright);
  }

  header {
    position: sticky;
    top: 2.5rem;
  }

  .wordmark {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
  }

  header nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  header nav a {
    display: block;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-muted);
    text-decoration: none;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }

  header nav a:hover {
    color: var(--ink);
    border-color: var(--ink-muted);
  }

  header nav a.active {
    color: var(--accent);
    border-color: var(--accent);
  }

  header nav a .soon {
    display: inline-block;
    margin-left: 0.4rem;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  @media (max-width: 46rem) {
    .shell {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    header {
      position: static;
    }

    header nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.25rem;
    }
  }

  footer {
    margin-top: 5rem;
  }

  footer .rule {
    display: block;
    width: 3rem;
    height: 2px;
    background: var(--accent);
    opacity: 0.6;
    margin-bottom: 1rem;
  }

  footer p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  img {
    max-width: 100%;
    border-radius: 4px;
  }

  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
    margin-right: 0.35rem;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  ::selection {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
  }
</style>
