---
// Shared page shell. Design: bone on graphite, no accent hue anywhere in the
// chrome — links carry an underline instead of a color, and emphasis is done
// with brightness. All saturated color belongs to the charts inside projects.
// Two columns on desktop: category nav on the left, page content on the right.
import { CATEGORIES } from '../categories';

interface Props {
  title: string;
  description?: string;
  /** Category slug to highlight in the sidebar, if the page belongs to one. */
  active?: string;
}
const { title, description = 'Projects and experiments by Jeff Brous.', active } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header>
        <a href="/" class="wordmark">jeffbrous<span class="dot">.</span></a>
        <nav aria-label="Project categories">
          <ul>
            {
              CATEGORIES.map((c) => (
                <li>
                  <a
                    href={`/${c.slug}/`}
                    class={active === c.slug ? 'active' : undefined}
                    aria-current={active === c.slug ? 'page' : undefined}
                  >
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
      <div class="column">
        <main>
          <slot />
        </main>
        <footer>
          <span class="rule" aria-hidden="true"></span>
          <p>© {new Date().getFullYear()} jeffbrous.com</p>
        </footer>
      </div>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #111214;
    --bg-raised: #191b1e;
    --ink: #f2efe9;
    --ink-muted: #9b9a96;
    --ink-faint: #6a6a67;
    /* Not a hue — "accent" here means brighter than the text around it. */
    --accent: #f2efe9;
    --accent-bright: #ffffff;
    --line: #26282c;
    --font-display: 'Fraunces', georgia, serif;
    --font-body: 'IBM Plex Sans', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color-scheme: dark;
  }

  body {
    margin: 0 auto;
    max-width: 58rem;
    padding: 2.5rem 1.25rem 4rem;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink);
    position: relative;
  }

  /* Nav column + content column. Collapses to a single stack on narrow screens. */
  .shell {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  .column {
    min-width: 0;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  h1 {
    font-size: 2.4rem;
    font-weight: 700;
  }

  a {
    color: var(--accent);
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 3px;
    transition: color 120ms ease;
  }

  a:hover {
    color: var(--accent-bright);
  }

  header {
    position: sticky;
    top: 2.5rem;
  }

  /* Deliberately not the display serif: Fraunces' f has a long overhanging
     hook, so the "ff" in jeffbrous collides. The grotesk keeps them apart. */
  .wordmark {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
  }

  .wordmark .dot {
    color: var(--accent);
  }

  header nav ul {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  header nav a {
    display: block;
    position: relative;
    padding: 0.35rem 0 0.35rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-muted);
    text-decoration: none;
  }

  /* Marker bar on the section you're in */
  header nav a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 140ms ease;
  }

  header nav a:hover {
    color: var(--ink);
  }

  header nav a:hover::before {
    opacity: 0.45;
  }

  header nav a.active {
    color: var(--accent);
  }

  header nav a.active::before {
    opacity: 1;
  }

  @media (max-width: 46rem) {
    .shell {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    header {
      position: static;
    }

    header nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.5rem;
      margin-top: 1.25rem;
    }

    header nav a {
      padding: 0.35rem 0;
    }

    header nav a::before {
      left: 0;
      right: 0;
      top: auto;
      bottom: 0;
      width: auto;
      height: 2px;
    }
  }

  footer {
    margin-top: 5rem;
  }

  footer .rule {
    display: block;
    width: 3rem;
    height: 2px;
    background: var(--accent);
    opacity: 0.6;
    margin-bottom: 1rem;
  }

  footer p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  img {
    max-width: 100%;
    border-radius: 4px;
  }

  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
    margin-right: 0.35rem;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  ::selection {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
  }
</style>
